Options -MultiViews
RewriteEngine On

# Sirve el HTML prerenderizado de cada ruta (/servicios/boxeo -> /servicios/boxeo/index.html).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# El resto es un 404 real, no el index.html con estado 200.
ErrorDocument 404 /404.html
